{
  "name": "sgdb2026_forecast_pipeline",
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "lakeflow_data_pipeline",
      "pipeline_task": {
        "pipeline_id": "<REPLACE_WITH_DLT_PIPELINE_ID>"
      },
      "timeout_seconds": 7200,
      "description": "Delta Live Tables pipeline defined by pipeline_lakeflow.py. Creates bronze_*, silver_*, gold_* tables in workspace.default."
    },
    {
      "task_key": "train_model",
      "depends_on": [{ "task_key": "lakeflow_data_pipeline" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/sgdb2026/pipeline/03_train_model",
        "source": "WORKSPACE"
      },
      "job_cluster_key": "ml_cluster",
      "timeout_seconds": 10800
    },
    {
      "task_key": "evaluate",
      "depends_on": [{ "task_key": "train_model" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/sgdb2026/pipeline/04_evaluate",
        "source": "WORKSPACE"
      },
      "job_cluster_key": "ml_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "inference",
      "depends_on": [{ "task_key": "evaluate" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/sgdb2026/pipeline/05_inference",
        "source": "WORKSPACE"
      },
      "job_cluster_key": "ml_cluster",
      "timeout_seconds": 3600
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "ml_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.2xlarge",
        "num_workers": 4,
        "spark_conf": {
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        }
      }
    }
  ],
  "email_notifications": {},
  "format": "MULTI_TASK"
}
